ARCADEDB_ROOT_PASSWORD=playwithdata
ARCADEDB_HOST=arcadedb
ARCADEDB_PORT=2480
ARCADEDB_DATABASE=platform
ARCADEDB_USER=root
ARCADEDB_PASSWORD=playwithdata

RELIABILITY_THRESHOLD=0.75
DISCOVERY_MODE=mixed

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

QUERY_PLANNER_TIMEOUT_SECONDS=5

EMBEDDING_DIMENSIONS=64

RANKING_RELEVANCE_WEIGHT=0.45
RANKING_RELIABILITY_WEIGHT=0.35
RANKING_FRESHNESS_WEIGHT=0.10
RANKING_EVIDENCE_WEIGHT=0.10
RANKING_CANDIDATE_LIMIT=100

# Result shaping: verified DB hits return at most this many servers;
# a cold-miss live discovery run returns at most the cold-miss cap.
SEARCH_VERIFIED_RESULT_CAP=3
SEARCH_COLD_MISS_RESULT_CAP=7

# Real discovery sources
ENABLE_GITHUB_DISCOVERY=true
ENABLE_MCP_REGISTRY_DISCOVERY=true
ENABLE_MCP_SERVICE_DISCOVERY=true

GITHUB_TOKEN=

# OAuth for remote MCP servers (tool test flow)
# Public base URL of the BACKEND that OAuth providers redirect to.
# Must be reachable from the user's browser. Default: http://localhost:8000
MCP_OAUTH_PUBLIC_BASE_URL=
# Frontend URL the callback page links back to. Default: http://localhost:4200
MCP_OAUTH_FRONTEND_URL=

DISCOVERY_MAX_RESULTS_PER_SOURCE=20

# MCP Server Verification subsystem (spec v2)
# Background worker poll interval for the verification queue (seconds).
VERIFICATION_POLL_INTERVAL_SECONDS=30

# Local MCP test sandbox containers (docker exec STDIO servers)
# Memory: heavyweight Python servers (uvx installs) can transiently exceed a
# tight cap and get OOM-killed (exit 137). 1536MB is a safe default; raise via
# platform/backend/.env if your Docker VM has RAM to spare.
SANDBOX_CPU_LIMIT=1.5
SANDBOX_MEMORY_LIMIT_MB=1536
# Swap headroom above the hard limit absorbs allocation spikes instead of
# triggering an instant SIGKILL.
SANDBOX_SWAP_HEADROOM_MB=256
SANDBOX_ENABLE_CACHE_VOLUMES=true
SANDBOX_NPM_CACHE_VOLUME=mcp_npm_cache
SANDBOX_PIP_CACHE_VOLUME=mcp_pip_cache
# Dedicated uv cache (uvx runtime hints) so OOM retries skip re-downloading.
SANDBOX_UV_CACHE_VOLUME=mcp_uv_cache
# Package-size preflight (prevents OOM / exit 137 before the container starts).
# npm: max dist.unpackedSize a local package may have and still be testable;
# PyPI: max declared runtime dependencies. Unknown size NEVER blocks (fail-open).
SANDBOX_NPM_SIZE_LIMIT_MB=40
SANDBOX_PYPI_DEP_LIMIT=25
