ARCADEDB_ROOT_PASSWORD=playwithdata
ARCADEDB_HOST=arcadedb
ARCADEDB_PORT=2480
ARCADEDB_DATABASE=platform
ARCADEDB_USER=root
ARCADEDB_PASSWORD=playwithdata

RELIABILITY_THRESHOLD=0.75
DISCOVERY_MODE=mixed

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

QUERY_PLANNER_TIMEOUT_SECONDS=5

EMBEDDING_DIMENSIONS=64

RANKING_RELEVANCE_WEIGHT=0.45
RANKING_RELIABILITY_WEIGHT=0.35
RANKING_FRESHNESS_WEIGHT=0.10
RANKING_EVIDENCE_WEIGHT=0.10
RANKING_CANDIDATE_LIMIT=100

# Real discovery sources
ENABLE_GITHUB_DISCOVERY=true
ENABLE_MCP_REGISTRY_DISCOVERY=true
ENABLE_MCP_SERVICE_DISCOVERY=true

GITHUB_TOKEN=

# OAuth for remote MCP servers (tool test flow)
# Public base URL of the BACKEND that OAuth providers redirect to.
# Must be reachable from the user's browser. Default: http://localhost:8000
MCP_OAUTH_PUBLIC_BASE_URL=
# Frontend URL the callback page links back to. Default: http://localhost:4200
MCP_OAUTH_FRONTEND_URL=

DISCOVERY_MAX_RESULTS_PER_SOURCE=20
